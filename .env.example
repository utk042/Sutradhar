# Sutradhar — environment variables
#
# Copy to `.env` in the repository root and fill in. `.env` is gitignored and
# must never be committed. Every variable the application reads is listed here.
#
#   cp .env.example .env
#
# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Signing key for session tokens. Minimum 32 characters. The application refuses
# to start without it, and rejects obvious placeholders.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SUTRADHAR_JWT_SECRET=

# Passwords for the two seeded users. Read only by scripts/seed.py, which
# refuses to run if either is unset — there is no default password anywhere.
#   python3 -c "import secrets; print(secrets.token_urlsafe(16))"
SUTRADHAR_SEED_OFFICER_PASSWORD=
SUTRADHAR_SEED_DEPT_HEAD_PASSWORD=

# ---------------------------------------------------------------------------
# Optional — defaults shown are what the application uses if unset
# ---------------------------------------------------------------------------

# development | production
# `production` also switches off the interactive API documentation.
SUTRADHAR_ENVIRONMENT=development

# Send session cookies only over HTTPS. MUST be true in production.
# Set false for local development, where the app is served over plain http.
SUTRADHAR_COOKIE_SECURE=true

# Cookie domain. Leave unset for a single-host deployment.
# SUTRADHAR_COOKIE_DOMAIN=

# Session lifetimes, in minutes.
SUTRADHAR_ACCESS_TOKEN_MINUTES=15
SUTRADHAR_REFRESH_TOKEN_MINUTES=720

# SQLite database file. Both engines derive their URL from this one path — the
# application's read-write engine and the read-only engine the checks use.
SUTRADHAR_DB_PATH=data/app.db

# Where uploaded documents are stored. Outside the web root by design; nothing
# is ever served back from a user-supplied path.
SUTRADHAR_UPLOAD_DIR=storage/uploads
SUTRADHAR_MAX_UPLOAD_BYTES=10485760

# Demonstration aid: milliseconds of artificial delay added to each check.
# Leave at 0 for normal operation and in production. With no model provider
# configured the checks finish in single-digit milliseconds, which is too fast
# for the live progress view to show anything; set this to e.g. 800 to make the
# progress — and the concurrency — visible. The delay is applied concurrently,
# so three checks at 800 ms still complete in about 800 ms.
SUTRADHAR_CHECK_DELAY_MS=0

# Origin allowed to call the API directly. In the normal setup the browser never
# does — Next.js proxies /api to the backend so requests are same-origin and the
# SameSite=Strict session cookie is actually sent.
SUTRADHAR_FRONTEND_ORIGIN=http://localhost:3000

# ---------------------------------------------------------------------------
# AI provider — wired in a later phase, recorded here so the seam is documented
# ---------------------------------------------------------------------------

# gemini | local
SUTRADHAR_LLM_PROVIDER=gemini
SUTRADHAR_GEMINI_API_KEY=
SUTRADHAR_LOCAL_MODEL_BASE_URL=http://localhost:11434

# ---------------------------------------------------------------------------
# Frontend (build time, server-side only)
# ---------------------------------------------------------------------------

# Backend origin the Next.js server proxies /api/* to. Never reaches the browser.
API_ORIGIN=http://127.0.0.1:8000
